package views

templ layout_entities(titulo string){
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>JamBox </title>
  <link rel="stylesheet" href="/static/styles.css">
    <meta name="htmx-config" content='{"noSwap":[204,304,"4xx","5xx"],"allowEmptySwapAfterOOB":true}'>
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0/dist/htmx.min.js"></script>
</head>
<body id="body" hx-on:htmx:response:error="alert('No se pudo completar la operación. Revisá los datos ingresados o si el elemento está siendo usado por otro.')">
    <header id="page-header">
        <a class="page-logo" href="/">JamBox</a>
        <nav id="page-nav">
            <li id="nav-songs"><a href="/songs">Canciones</a></li>
            <li id="nav-artists"><a href="/artists">Artistas</a></li>
            <li id="nav-albums"><a href="/albums">Álbumes</a></li>
            <li id="nav-reviews"><a href="/reviews">Reseñas</a></li>
            <li id="nav-members"><a href="/users">Usuarios</a></li>
        </nav>
    </header>

    <main>
        { children... }
    </main>

      <footer id="site-footer">
    <div id="footer-container">
      <nav id="footer-nav">
        <a id="footer-about" href="/acerca">Acerca de</a>
        <a id="footer-help" href="/ayuda">Ayuda</a>
        <a id="footer-terms" href="/terminos">Términos</a>
        <a id="footer-privacy" href="/privacidad">Privacidad</a>
        <a id="footer-contact" href="/contacto">Contacto</a>
      </nav>
      <p id="footer-copy">© 2026 JamBox. Hecho por y para amantes de la música.</p>
    </div>
  </footer>
</body>
</html>
}