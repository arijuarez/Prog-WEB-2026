package views

import (
	"fmt"
	db "github.com/arijuarez/Prog-WEB-2026/bd/sqlc"
)

// duracion convierte segundos a "m:ss" (o "h:mm:ss" si pasa la hora).
func duracion(seg int32) string {
	if seg >= 3600 {
		return fmt.Sprintf("%d:%02d:%02d", seg/3600, seg%3600/60, seg%60)
	}
	return fmt.Sprintf("%d:%02d", seg/60, seg%60)
}

templ UserList(users []db.User){
    <section class="entity-list-panel" id="user-list"> 
		<div class="entity-list-header">
			<h2>Todos los usuarios</h2>
			@ListCount(len(users), false)
		</div>
		<ul id="lista">
			for _, user := range users {
				<li>
					<span>{ user.UserName }</span>
					<span class="chip-id">ID <strong>{ fmt.Sprint(user.IDUser) }</strong></span>
					<span>Amigos <strong>{ fmt.Sprint(user.Amigos) }</strong></span>
					if user.Photo != 0 {
						<span>Foto <strong>#{ fmt.Sprint(user.Photo) }</strong></span>
					}

					<button type="button"
						hx-delete={ fmt.Sprintf("/users/%d", user.IDUser) }
						hx-target="closest li"
						hx-swap="outerHTML"
						hx-confirm="¿Seguro que querés eliminar este usuario?">
						Eliminar
					</button>
				</li>
			}
		</ul>
	</section>
}


templ ArtistsList(artists []db.Artist){
    <section class="entity-list-panel" id="artist-list"> 
		<div class="entity-list-header">
			<h2>Todos los artistas</h2>
			@ListCount(len(artists), false)
		</div>
        <ul id="lista">
			for _, artist := range artists {
				<li>
					<span>{ artist.ArtistName }</span>
					<span class="chip-id">ID <strong>{ fmt.Sprint(artist.IDArtist) }</strong></span>
					if artist.Photo != 0 {
						<span>Foto <strong>#{ fmt.Sprint(artist.Photo) }</strong></span>
					}
					if artist.ArtistBio != "" {
						<span class="item-desc">{ artist.ArtistBio }</span>
					}

					<button type="button"
						hx-delete={ fmt.Sprintf("/artists/%d", artist.IDArtist) }
						hx-target="closest li"
						hx-swap="outerHTML"
						hx-confirm="¿Seguro que querés eliminar este artista?">
						Eliminar
					</button>
				</li>
			}
		</ul>
	</section>
}


templ SongList(songs []db.Song){
    <section class="entity-list-panel" id="song-list"> 
		<div class="entity-list-header">
			<h2>Todas las canciones</h2>
			@ListCount(len(songs), false)
		</div>
        <ul id="lista">
			for _, song := range songs {
				<li>
					<span>{ song.SongName }</span>
					<span class="chip-id">ID <strong>{ fmt.Sprint(song.IDSong) }</strong></span>
					<span>Álbum <strong>#{ fmt.Sprint(song.AlbumIDAlbum) }</strong></span>
					<span>Duración <strong>{ duracion(song.SongDur) }</strong></span>
					<span>♥ <strong>{ fmt.Sprint(song.Likes) }</strong></span>

					<button type="button"
						hx-delete={ fmt.Sprintf("/songs/%d", song.IDSong) }
						hx-target="closest li"
						hx-swap="outerHTML"
						hx-confirm="¿Seguro que querés eliminar esta canción?">
						Eliminar
					</button>
				</li>
			}
		</ul>
	</section>
}


templ ReviewList(reviews []db.Review){
    <section class="entity-list-panel" id="review-list"> 
		<div class="entity-list-header">
			<h2>Todas las reviews</h2>
			@ListCount(len(reviews), false)
		</div>
        <ul id="lista">
			for _, review := range reviews {
				<li>
					<span>{ review.ReviewText }</span>
					<span class="chip-id">ID <strong>{ fmt.Sprint(review.IDReview) }</strong></span>
					<span class="chip-rate">★ <strong>{ fmt.Sprintf("%.1f", review.ReviewRate) }</strong></span>
					<span>Fecha <strong>{ review.ReviewDate.Format("02/01/2006") }</strong></span>
					<span>Usuario <strong>#{ fmt.Sprint(review.UserIDUser) }</strong></span>
					if review.SongIDSong.Valid {
						<span>Canción <strong>#{ fmt.Sprint(review.SongIDSong.Int32) }</strong></span>
					}
					if review.AlbumIDAlbum.Valid {
						<span>Álbum <strong>#{ fmt.Sprint(review.AlbumIDAlbum.Int32) }</strong></span>
					}
					<span>♥ <strong>{ fmt.Sprint(review.Likes) }</strong></span>

					<button type="button"
						hx-delete={ fmt.Sprintf("/reviews/%d", review.IDReview) }
						hx-target="closest li"
						hx-swap="outerHTML"
						hx-confirm="¿Seguro que querés eliminar esta reseña?">
						Eliminar
					</button>
				</li>
			}
		</ul>
	</section>
}

templ AlbumList(albums []db.Album){
    <section class="entity-list-panel" id="album-list"> 
		<div class="entity-list-header">
			<h2>Todos los álbumes</h2>
			@ListCount(len(albums), false)
		</div>
        <ul id="lista">
			for _, album := range albums {
				<li>
					<span>{ album.AlbumName }</span>
					<span class="chip-id">ID <strong>{ fmt.Sprint(album.IDAlbum) }</strong></span>
					<span>Artista <strong>#{ fmt.Sprint(album.ArtistIDArtist) }</strong></span>
					<span>Lanzamiento <strong>{ album.ReleaseDate.Format("02/01/2006") }</strong></span>
					<span>Duración <strong>{ duracion(album.AlbumDur) }</strong></span>
					<span>♥ <strong>{ fmt.Sprint(album.Likes) }</strong></span>
					if album.AlbumPh != 0 {
						<span>Portada <strong>#{ fmt.Sprint(album.AlbumPh) }</strong></span>
					}

					<button type="button"
						hx-delete={ fmt.Sprintf("/albums/%d", album.IDAlbum) }
						hx-target="closest li"
						hx-swap="outerHTML"
						hx-confirm="¿Seguro que querés eliminar este álbum?">
						Eliminar
					</button>
				</li>
			}
		</ul>
	</section>
}

// ListCount es el contador de elementos de una lista.
// Con oob=true se renderiza con hx-swap-oob para que HTMX lo reemplace
// en la página aunque no sea el hx-target (se usa en la respuesta del DELETE).
templ ListCount(n int, oob bool) {
	<span class="entity-count" id="lista-count"
		if oob {
			hx-swap-oob="true"
		}
	>{ fmt.Sprintf("%d", n) }</span>
}
